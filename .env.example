# Copy to .env and replace the placeholders. Do not commit .env.
POSTGRES_DB=retailiq_db
POSTGRES_USER=retailiq
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_PORT=5432
SERVER_PORT=8080
ML_SERVICE_PORT=8000
# For running Spring on the host use http://localhost:8000. Compose sets the internal service URL.
ML_SERVICE_BASE_URL=http://localhost:8000

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-at-least-32-random-bytes-encoded-as-base64
JWT_EXPIRATION=86400000
